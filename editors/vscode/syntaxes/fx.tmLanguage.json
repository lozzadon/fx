{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "f(x)",
  "patterns": [
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#comments" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#functions" }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.fx",
          "match": "\\b(if|else|return|while|for|in|match|try|catch|throw)\\b"
        },
        {
          "name": "keyword.other.fx",
          "match": "\\b(let|var|func|import)\\b"
        },
        {
          "name": "constant.language.fx",
          "match": "\\b(true|false|null|nil)\\b"
        },
        {
          "name": "support.type.fx",
          "match": "\\b(Int|Float|String|Boolean|Array|Hash|Function)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.fx",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.fx",
          "match": "\\\\."
        },
        {
          "name": "meta.embedded.line.fx",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            { "include": "$self" }
          ]
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.fx",
          "match": "//.*$"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.fx",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.fx",
          "match": "(=>|==|!=|<=|>=|<|>|\\+|-|\\*|/|!|&&|\\|\\||=|->|:)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": {
              "name": "entity.name.function.fx"
            }
          }
        }
      ]
    }
  },
  "scopeName": "source.fx"
}
