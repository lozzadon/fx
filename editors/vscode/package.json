{
  "name": "fx-language",
  "displayName": "f(x) Language",
  "description": "Syntax highlighting and language support for the f(x) programming language.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "fx",
        "aliases": ["f(x)", "fx"],
        "extensions": [".fx"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fx",
        "scopeName": "source.fx",
        "path": "./syntaxes/fx.tmLanguage.json"
      }
    ]
  }
}
